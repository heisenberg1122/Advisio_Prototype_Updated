# Environment Configuration for Advisio Platform

# Database connection (PostgreSQL 16)
DATABASE_URL="postgresql://advisio_local:advisio_local_password@127.0.0.1:5433/advisio_local?schema=public"
DIRECT_URL="postgresql://advisio_local:advisio_local_password@127.0.0.1:5433/advisio_local?schema=public"

# Dedicated database integration tests only (docker compose up -d postgres-test)
# Never point this at advisio_local, staging, or production.
INTEGRATION_DATABASE_URL="postgresql://advisio_test:advisio_test_password@127.0.0.1:5434/advisio_test?schema=public&application_name=advisio-integration-tests"
INTEGRATION_DATABASE_EXPECTED_NAME="advisio_test"
RUN_DATABASE_INTEGRATION_TESTS="0"

# Authentication & JWT
JWT_SECRET="advisio-super-secret-key-change-in-production"
AUTH_SECRET="advisio-super-secret-key-change-in-production"

# API Server & CORS
PORT=5000
API_URL="http://localhost:5000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Demo accounts (development/test only; keep disabled in production)
ALLOW_DEMO_ACCOUNT_PROVISIONING="false"
ALLOW_THEME_DEMO_ACCOUNTS="false"
DEMO_ACCOUNT_PASSWORD=""
VITE_ENABLE_DEMO_ACCOUNTS="false"
VITE_DEMO_ACCOUNT_PASSWORD=""

# Google Drive & Calendar API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CALENDAR_ID="primary"
STORAGE_PROVIDER="GOOGLE_DRIVE"
INTEGRATION_ENCRYPTION_KEY="replace-with-a-long-random-secret"
ALLOW_LOCAL_STORAGE_FALLBACK="false"
# Alternative: Service Account auth
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Google Sign-In (separate from the Google Drive integration above)
# The same OAuth client ID is used by the browser and API for ID-token verification.
VITE_GOOGLE_SIGN_IN_CLIENT_ID=""
GOOGLE_SIGN_IN_CLIENT_ID=""
# Enable only in the test environment to create active researcher accounts on first sign-in.
GOOGLE_SIGN_IN_ALLOW_SELF_SIGNUP="false"
VITE_GOOGLE_SIGN_IN_ALLOW_SELF_SIGNUP="false"

# Email SMTP / Resend
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
RESEND_API_KEY=""
