# Environment Configuration for Advisio Platform

# Database connection (PostgreSQL 16)
DATABASE_URL="postgresql://advisio_local:advisio_local_password@127.0.0.1:5433/advisio_local?schema=public"
DIRECT_URL="postgresql://advisio_local:advisio_local_password@127.0.0.1:5433/advisio_local?schema=public"

# Authentication & JWT
JWT_SECRET="advisio-super-secret-key-change-in-production"
AUTH_SECRET="advisio-super-secret-key-change-in-production"

# API Server & CORS
PORT=5000
API_URL="http://localhost:5000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Google Drive & Calendar API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CALENDAR_ID="primary"
# Alternative: Service Account auth
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Email SMTP / Resend
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
RESEND_API_KEY=""
