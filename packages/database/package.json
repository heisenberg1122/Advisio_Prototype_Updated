{
  "name": "@research-management/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "seed:demo": "node --env-file=../../.env dist/development-seed.js",
    "bootstrap:admin": "node --env-file-if-exists=../../.env dist/bootstrap-admin.js",
    "panel-demo": "node --env-file-if-exists=../../.env dist/panel-demo.js",
    "test:panel-demo": "node scripts/verify-panel-demo-safety.mjs",
    "demo:local": "node --env-file=../../.env.demo.local dist/local-demo.js",
    "test:demo-local": "node scripts/verify-local-demo-safety.mjs",
    "demo:themes:seed": "tsc && node --env-file=../../.env dist/theme-demo-accounts.js seed",
    "demo:themes:cleanup": "tsc && node --env-file=../../.env dist/theme-demo-accounts.js cleanup"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "typescript": "^5.6.3"
  }
}
