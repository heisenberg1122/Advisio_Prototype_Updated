// packages/database/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ─────────────────────────────────────────────────────────────
// ENUMS — Single source of truth for status values
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum InstitutionalRole {
  RESEARCHER
  ADVISER
  PANELIST
  RESEARCH_COORDINATOR
  RPO
  REB
  VPAA
  SYSTEM_ADMIN
}

enum ProjectRole {
  LEADER
  MEMBER
  ADVISER
  PANELIST
  COORDINATOR
}

enum ResearchStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION
  APPROVED
  DEFENSE
  COMPLETED
  ARCHIVED
  REJECTED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewType {
  ADVISER
  PANEL
  REB
  COORDINATOR
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  RETURNED
}

enum ReviewRecommendation {
  APPROVE
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum CommentStatus {
  OPEN
  RESOLVED
  REPLIED
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
  SIGNATURE
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum ConsultationStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  INVITED
  ACCEPTED
  DECLINED
  JOINED
  LEFT
  NO_SHOW
}

enum CertificateType {
  REB_APPROVAL
  COMPLETION
  DEFENSE_PASSED
  PANEL_RECOMMENDATION
}

enum CertificateStatus {
  ISSUED
  REVOKED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  TRANSITION
  PUBLISH
  LOGIN
  LOGOUT
  ROLE_CHANGE
  PERMISSION_CHANGE
}

enum NotificationType {
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  REVISION_REQUESTED
  WORKFLOW_CHANGED
  CONSULTATION_SCHEDULED
  REB_DECISION
  CERTIFICATE_READY
  DEADLINE_APPROACHING
  RESEARCH_ASSIGNED
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION MODEL
// ─────────────────────────────────────────────────────────────

model College {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(150)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  programs         Program[]
  users            User[]
  researchProjects ResearchProject[]
  forms            Form[]
  dashboardConfigs DashboardConfig[]

  @@index([isActive])
  @@map("colleges")
}

model Program {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @map("college_id") @db.Uuid
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  college          College           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  users            User[]
  researchTypes    ResearchType[]
  researchProjects ResearchProject[]

  @@unique([collegeId, code])
  @@index([isActive])
  @@map("programs")
}

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(20) // "2025-2026"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  isActive  Boolean  @default(true) @map("is_active")

  researchProjects ResearchProject[]

  @@map("academic_years")
}

// ─────────────────────────────────────────────────────────────
// USERS, ROLES, PERMISSIONS (RBAC)
// ─────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String     @unique @map("university_id") @db.VarChar(50)
  email        String     @unique @db.Citext
  firstName    String     @map("first_name") @db.VarChar(100)
  middleName   String?    @map("middle_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  collegeId    String?    @map("college_id") @db.Uuid
  programId    String?    @map("program_id") @db.Uuid
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  college             College?          @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  program             Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  roles               UserRole[]
  memberships         ResearchMember[]
  ownedResearch            ResearchProject[]          @relation("ProjectCreator")
  reviews                  Review[]
  comments                 ReviewComment[]
  evaluations              Evaluation[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  certificatesIssued       Certificate[]              @relation("CertificateIssuer")
  workflowTransitions      WorkflowTransition[]
  consultationParticipants ConsultationParticipant[]

  @@index([collegeId])
  @@index([programId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        InstitutionalRole @unique
  description String?           @db.Text
  isSystem    Boolean           @default(true) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  users            UserRole[]
  permissions      RolePermission[]
  dashboardWidgets RoleDashboardWidget[]
  workflowStages   WorkflowStage[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique @db.VarChar(100) // e.g. "research.create"
  module      String  @db.VarChar(50) // grouping for UI
  description String? @db.Text

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// RESEARCH MANAGEMENT
// ─────────────────────────────────────────────────────────────

model ResearchType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  name        String   @db.VarChar(150)
  code        String   @db.VarChar(50)
  description String?  @db.Text
  workflowId  String?  @map("workflow_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  program             Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  workflow            Workflow?            @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  researchProjects    ResearchProject[]
  forms               Form[]
  evaluationTemplates EvaluationTemplate[]

  @@unique([programId, code])
  @@index([isActive])
  @@map("research_types")
}

model ResearchProject {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchTypeId     String         @map("research_type_id") @db.Uuid
  programId          String         @map("program_id") @db.Uuid
  collegeId          String         @map("college_id") @db.Uuid
  academicYearId     String         @map("academic_year_id") @db.Uuid
  title              String         @db.Text
  abstract           String?        @db.Text
  status             ResearchStatus @default(DRAFT)
  workflowInstanceId String?        @unique @map("workflow_instance_id") @db.Uuid
  createdBy          String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  completedAt        DateTime?      @map("completed_at")

  researchType     ResearchType      @relation(fields: [researchTypeId], references: [id], onDelete: Restrict)
  program          Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  college          College           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  creator          User              @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)

  members         ResearchMember[]
  documents       Document[]
  formSubmissions FormSubmission[]
  evaluations     Evaluation[]
  consultations   Consultation[]
  certificates    Certificate[]

  @@index([status])
  @@index([collegeId, academicYearId])
  @@index([researchTypeId])
  @@map("research_projects")
}

model ResearchMember {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId  String      @map("research_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  projectRole ProjectRole
  joinedAt    DateTime    @default(now()) @map("joined_at")
  leftAt      DateTime?   @map("left_at")

  research ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([researchId, userId, projectRole])
  @@index([userId])
  @@map("research_members")
}

// ─────────────────────────────────────────────────────────────
// WORKFLOW ENGINE
// ─────────────────────────────────────────────────────────────

model Workflow {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchTypeId String         @map("research_type_id") @db.Uuid
  name           String         @db.VarChar(150)
  description    String?        @db.Text
  version        Int            @default(1)
  status         WorkflowStatus @default(DRAFT)
  createdBy      String         @map("created_by") @db.Uuid
  publishedAt    DateTime?      @map("published_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  researchTypes ResearchType[]
  stages        WorkflowStage[]
  instances     WorkflowInstance[]

  @@unique([researchTypeId, version])
  @@index([status])
  @@map("workflows")
}

model WorkflowStage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String   @map("workflow_id") @db.Uuid
  name              String   @db.VarChar(150)
  description       String?  @db.Text
  sequence          Int
  responsibleRoleId String   @map("responsible_role_id") @db.Uuid
  requiresApproval  Boolean  @default(true) @map("requires_approval")
  deadlineDays      Int?     @map("deadline_days")
  isFinal           Boolean  @default(false) @map("is_final")

  workflow        Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  responsible     Role                 @relation(fields: [responsibleRoleId], references: [id], onDelete: Restrict)
  fromTransitions WorkflowTransition[] @relation("FromStage")
  toTransitions   WorkflowTransition[] @relation("ToStage")
  currentInstances WorkflowInstance[]

  @@unique([workflowId, sequence])
  @@map("workflow_stages")
}

model WorkflowInstance {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId      String    @unique @map("research_id") @db.Uuid
  workflowId      String    @map("workflow_id") @db.Uuid
  workflowVersion Int       @map("workflow_version")
  currentStageId  String?   @map("current_stage_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  workflow     Workflow             @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  currentStage WorkflowStage?       @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  research     ResearchProject?
  transitions  WorkflowTransition[]

  @@index([workflowId])
  @@map("workflow_instances")
}

model WorkflowTransition {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String   @map("workflow_instance_id") @db.Uuid
  fromStageId        String?  @map("from_stage_id") @db.Uuid
  toStageId          String   @map("to_stage_id") @db.Uuid
  performedBy        String   @map("performed_by") @db.Uuid
  remarks            String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  fromStage        WorkflowStage?   @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage          WorkflowStage    @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  performedByUser  User             @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([workflowInstanceId])
  @@map("workflow_transitions")
}

// ─────────────────────────────────────────────────────────────
// DOCUMENTS & REVIEWS
// ─────────────────────────────────────────────────────────────

model Document {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId      String   @map("research_id") @db.Uuid
  documentType    String   @db.VarChar(50)
  title           String   @db.VarChar(255)
  currentVersion  Int      @default(1) @map("current_version")
  storageProvider String   @default("GOOGLE_DRIVE") @map("storage_provider")
  externalFileId  String?  @map("external_file_id") @db.VarChar(255)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  research ResearchProject   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]
  reviews  Review[]

  @@index([researchId])
  @@map("documents")
}

model DocumentVersion {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String         @map("document_id") @db.Uuid
  versionNumber     Int            @map("version_number")
  fileName          String         @map("file_name") @db.VarChar(255)
  mimeType          String         @map("mime_type") @db.VarChar(100)
  fileSize          BigInt         @map("file_size")
  storagePath       String         @map("storage_path") @db.VarChar(500)
  googleDriveFileId String?        @map("google_drive_file_id") @db.VarChar(255)
  uploadedBy        String         @map("uploaded_by") @db.Uuid
  uploadedAt        DateTime       @default(now()) @map("uploaded_at")
  status            DocumentStatus @default(ACTIVE)

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviews  Review[]
  comments ReviewComment[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model Review {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String                @map("document_version_id") @db.Uuid
  documentId        String                @map("document_id") @db.Uuid
  reviewerId        String                @map("reviewer_id") @db.Uuid
  reviewType        ReviewType
  overallComment    String?               @map("overall_comment") @db.Text
  recommendation    ReviewRecommendation?
  status            ReviewStatus          @default(DRAFT)
  createdAt         DateTime              @default(now()) @map("created_at")
  submittedAt       DateTime?             @map("submitted_at")

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer        User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  comments        ReviewComment[]

  @@index([documentId])
  @@index([reviewerId])
  @@map("reviews")
}

model ReviewComment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId          String        @map("review_id") @db.Uuid
  documentVersionId String        @map("document_version_id") @db.Uuid
  authorId          String        @map("author_id") @db.Uuid
  comment           String        @db.Text
  locationData      Json?         @map("location_data")
  status            CommentStatus @default(OPEN)
  createdAt         DateTime      @default(now()) @map("created_at")
  resolvedAt        DateTime?     @map("resolved_at")

  review          Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@map("review_comments")
}

// ─────────────────────────────────────────────────────────────
// DYNAMIC FORMS
// ─────────────────────────────────────────────────────────────

model Form {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String     @db.VarChar(150)
  code           String     @db.VarChar(50)
  description    String?    @db.Text
  collegeId      String?    @map("college_id") @db.Uuid
  researchTypeId String?    @map("research_type_id") @db.Uuid
  version        Int        @default(1)
  status         FormStatus @default(DRAFT)
  createdBy      String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  college      College?        @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  researchType ResearchType?   @relation(fields: [researchTypeId], references: [id], onDelete: SetNull)
  fields       FormField[]
  submissions  FormSubmission[]

  @@unique([code, version])
  @@index([status])
  @@map("forms")
}

model FormField {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId          String    @map("form_id") @db.Uuid
  fieldKey        String    @map("field_key") @db.VarChar(100)
  label           String    @db.VarChar(200)
  fieldType       FieldType @map("field_type")
  isRequired      Boolean   @default(false) @map("is_required")
  validationRules Json?     @map("validation_rules")
  options         Json?
  sequence        Int

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldKey])
  @@index([formId])
  @@map("form_fields")
}

model FormSubmission {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId      String               @map("form_id") @db.Uuid
  researchId  String               @map("research_id") @db.Uuid
  submittedBy String               @map("submitted_by") @db.Uuid
  status      FormSubmissionStatus @default(DRAFT)
  data        Json
  submittedAt DateTime?            @map("submitted_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  form     Form            @relation(fields: [formId], references: [id], onDelete: Restrict)
  research ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([researchId])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────────────────────
// EVALUATIONS
// ─────────────────────────────────────────────────────────────

model EvaluationTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(150)
  researchTypeId String?  @map("research_type_id") @db.Uuid
  version        Int      @default(1)
  totalScore     Decimal  @map("total_score") @db.Decimal(6, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  researchType ResearchType?         @relation(fields: [researchTypeId], references: [id], onDelete: SetNull)
  criteria     EvaluationCriterion[]
  evaluations  Evaluation[]

  @@unique([name, version])
  @@map("evaluation_templates")
}

model EvaluationCriterion {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  criterion   String  @db.VarChar(200)
  description String? @db.Text
  maxScore    Decimal @map("max_score") @db.Decimal(5, 2)
  weight      Decimal @default(1.0) @db.Decimal(4, 2)
  sequence    Int

  template EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sequence])
  @@map("evaluation_criteria")
}

model Evaluation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId     String                @map("template_id") @db.Uuid
  researchId     String                @map("research_id") @db.Uuid
  evaluatorId    String                @map("evaluator_id") @db.Uuid
  status         EvaluationStatus      @default(DRAFT)
  totalScore     Decimal?              @map("total_score") @db.Decimal(6, 2)
  recommendation ReviewRecommendation? @map("recommendation")
  submittedAt    DateTime?             @map("submitted_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  template  EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  research  ResearchProject    @relation(fields: [researchId], references: [id], onDelete: Cascade)
  evaluator User               @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([templateId, researchId, evaluatorId])
  @@index([researchId])
  @@map("evaluations")
}

// ─────────────────────────────────────────────────────────────
// CONSULTATIONS
// ─────────────────────────────────────────────────────────────

model Consultation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId     String             @map("research_id") @db.Uuid
  createdBy      String             @map("created_by") @db.Uuid
  title          String             @db.VarChar(200)
  description    String?            @db.Text
  scheduledStart DateTime           @map("scheduled_start")
  scheduledEnd   DateTime           @map("scheduled_end")
  meetingUrl     String?            @map("meeting_url") @db.VarChar(500)
  status         ConsultationStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now()) @map("created_at")

  research     ResearchProject           @relation(fields: [researchId], references: [id], onDelete: Cascade)
  participants ConsultationParticipant[]
  notes        ConsultationNote[]

  @@index([researchId])
  @@index([scheduledStart])
  @@map("consultations")
}

model ConsultationParticipant {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId   String           @map("consultation_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  attendanceStatus AttendanceStatus @default(INVITED) @map("attendance_status")
  joinedAt         DateTime?        @map("joined_at")
  leftAt           DateTime?        @map("left_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([consultationId, userId])
  @@map("consultation_participants")
}

model ConsultationNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  notes          String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("consultation_notes")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String           @db.Text
  entityType  String?          @map("entity_type") @db.VarChar(50)
  entityId    String?          @map("entity_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String?     @map("entity_id") @db.Uuid
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────

model Certificate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId        String            @map("research_id") @db.Uuid
  certificateType   CertificateType   @map("certificate_type")
  certificateNumber String            @unique @map("certificate_number") @db.VarChar(50)
  issuedBy          String            @map("issued_by") @db.Uuid
  issuedAt          DateTime          @default(now()) @map("issued_at")
  fileId            String?           @map("file_id") @db.VarChar(255)
  verificationCode  String            @unique @map("verification_code") @db.VarChar(64)
  status            CertificateStatus @default(ISSUED)

  research ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)
  issuer   User            @relation("CertificateIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)

  @@index([researchId])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────
// DASHBOARD CONFIGURATION
// ─────────────────────────────────────────────────────────────

model DashboardWidget {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String  @db.VarChar(150)
  widgetType          String  @map("widget_type") @db.VarChar(50)
  description         String? @db.Text
  configurationSchema Json?   @map("configuration_schema")
  isActive            Boolean @default(true) @map("is_active")

  roleWidgets    RoleDashboardWidget[]
  collegeConfigs DashboardConfig[]

  @@unique([widgetType, name])
  @@map("dashboard_widgets")
}

model RoleDashboardWidget {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  widgetId      String @map("widget_id") @db.Uuid
  position      Int
  size          String @default("MEDIUM") @db.VarChar(20)
  defaultConfig Json?  @map("default_config")

  role   Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  widget DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([roleId, widgetId])
  @@map("role_dashboard_widgets")
}

model DashboardConfig {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String @map("college_id") @db.Uuid
  widgetId  String @map("widget_id") @db.Uuid
  config    Json
  position  Int

  college College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  widget  DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([collegeId, widgetId])
  @@map("dashboard_configs")
}
