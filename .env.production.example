# Render API (server-side variables)
NODE_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
JWT_SECRET="GENERATE_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS"
AUTH_SECRET="GENERATE_A_DIFFERENT_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS"
WEB_URL="https://advisio-prototype-updated.vercel.app"
CORS_ORIGIN="https://advisio-prototype-updated.vercel.app"

# Google OAuth, Drive, and Calendar (server-side; never add secrets to Vercel)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://YOUR_RENDER_DOMAIN/api/integrations/google-drive/callback"
GOOGLE_DRIVE_FOLDER_ID="PRODUCTION_FOLDER_ID_FOR_ADVISIO_RESEARCH_DOCUMENTS"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SIGN_IN_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
STORAGE_PROVIDER="GOOGLE_DRIVE"
INTEGRATION_ENCRYPTION_KEY="GENERATE_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS"
ALLOW_LOCAL_STORAGE_FALLBACK="false"

# Email
EMAIL_PROVIDER="resend"
# To use Gmail instead, set EMAIL_PROVIDER=gmail and fill these four values.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="advisio.main@gmail.com"
MAIL_EMAIL_NOTIFICATIONS="false"
NOTIFICATION_EMAILS_ENABLED="false"
EMAIL_LOGO_URL=""
EMAIL_TEMPLATE_OVERRIDES_PATH=""
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="Advisio <notifications@YOUR_VERIFIED_DOMAIN>"

# Production safety switches
ALLOW_DEMO_ACCOUNT_PROVISIONING="false"
ALLOW_THEME_DEMO_ACCOUNTS="false"
# Google registration creates pending accounts; administrator approval is required.

# One-time admin bootstrap only. Set temporarily, run the bootstrap command, then remove.
BOOTSTRAP_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
BOOTSTRAP_ADMIN_UNIVERSITY_ID="YOUR_ADMIN_UNIVERSITY_ID"
BOOTSTRAP_ADMIN_FIRST_NAME="YOUR_ADMIN_FIRST_NAME"
BOOTSTRAP_ADMIN_LAST_NAME="YOUR_ADMIN_LAST_NAME"
BOOTSTRAP_ADMIN_PASSWORD="GENERATE_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS"

# Vercel web app (build-time variables; configure these in Vercel, not Render)
VITE_API_URL="https://YOUR_RENDER_DOMAIN"
VITE_GOOGLE_SIGN_IN_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
VITE_ENABLE_DEMO_ACCOUNTS="false"
