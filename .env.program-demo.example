# Copy to .env.program-demo.local (Git-ignored), or set these in the deployment shell.
# This tool never selects a target from the ordinary development DATABASE_URL.
PROGRAM_DEMO_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require&sslaccept=strict"
PROGRAM_DEMO_EXPECTED_HOST="HOST"
PROGRAM_DEMO_EXPECTED_DATABASE="DATABASE"
PROGRAM_DEMO_LIVE_CONFIRMATION="CREATE:ADVISIO-PROGRAM-DEMO-V1"
PROGRAM_DEMO_BSN_PASSWORD=""
PROGRAM_DEMO_BSA_PASSWORD=""
PROGRAM_DEMO_BSCPE_PASSWORD=""
PROGRAM_DEMO_BEED_PASSWORD=""
# For execution inside the existing Render service using its unchanged private connection:
# PROGRAM_DEMO_RENDER_SERVICE_ID="THE_EXISTING_RENDER_SERVICE_ID"

# Match the live deployment's storage provider and credentials. Prefer running
# inside its maintenance shell so existing encrypted Drive/storage configuration works.
# Do not change the deployed service's NODE_ENV, auth, or general demo seed flags.
STORAGE_PROVIDER="GOOGLE_DRIVE"

# Only for removal, after inspecting cleanup-preview:
# PROGRAM_DEMO_CLEANUP_CONFIRMATION="DELETE:ADVISIO-PROGRAM-DEMO-V1"
# PROGRAM_DEMO_CLEANUP_PREVIEW_HASH="COPY_THE_HASH_FROM_CLEANUP_PREVIEW"
