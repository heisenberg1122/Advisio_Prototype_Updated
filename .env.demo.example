# Advisio isolated local demonstration environment
# Copy this file to .env.demo.local. The copied file is Git-ignored.

NODE_ENV="development"
ADVISIO_LOCAL_DEMO="1"
LOCAL_DEMO_EXECUTION="1"
LOCAL_DEMO_DATASET_ID="ADVISIO-DEMO-LOCAL-V1"
LOCAL_DEMO_DATABASE_NAME="advisio_demo_local"
LOCAL_DEMO_DATABASE_HOST="127.0.0.1"
LOCAL_DEMO_DATABASE_PORT="5435"
LOCAL_DEMO_CREDENTIALS_FILE=".demo-local/credentials.json"

DATABASE_URL="postgresql://advisio_demo_local:advisio_demo_local_password@127.0.0.1:5435/advisio_demo_local?schema=public&application_name=advisio-demo-local"
DIRECT_URL="postgresql://advisio_demo_local:advisio_demo_local_password@127.0.0.1:5435/advisio_demo_local?schema=public&application_name=advisio-demo-local"

JWT_SECRET="advisio-demo-local-jwt-secret-change-only-if-you-want-a-new-local-session-key"
AUTH_SECRET="advisio-demo-local-auth-secret-change-only-if-you-want-a-new-local-session-key"
PORT="5055"
API_URL="http://127.0.0.1:5055"
VITE_API_URL="http://127.0.0.1:5055"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# LOCAL is a filesystem-backed provider under apps/api/uploads.
STORAGE_PROVIDER="LOCAL"
ALLOW_LOCAL_STORAGE_FALLBACK="true"

# Explicitly disconnect all external storage/calendar identities in demo mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
VITE_GOOGLE_SIGN_IN_CLIENT_ID=""
GOOGLE_SIGN_IN_CLIENT_ID=""
GOOGLE_SIGN_IN_ALLOW_SELF_SIGNUP="false"
VITE_GOOGLE_SIGN_IN_ALLOW_SELF_SIGNUP="false"

ALLOW_DEMO_ACCOUNT_PROVISIONING="false"
ALLOW_THEME_DEMO_ACCOUNTS="false"
VITE_ENABLE_DEMO_ACCOUNTS="false"

EMAIL_HOST=""
EMAIL_PORT="2525"
EMAIL_USER=""
EMAIL_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="Advisio Local Demo <demo@localhost.invalid>"
