{
  "name": "research-management-system",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "evaluation:serve": "node scripts/start-evaluation.mjs",
    "test:evaluation:hosting": "node --test scripts/hosted-evaluation-config.test.mjs",
    "evaluation:init-local": "node scripts/evaluation.mjs init-local",
    "evaluation:prepare": "node scripts/evaluation.mjs prepare",
    "evaluation:dev": "node scripts/evaluation.mjs dev",
    "test:evaluation": "npm --workspace=api run test -- src/evaluation",
    "test:evaluation:local": "node scripts/verify-qr-evaluation.mjs",
    "email:test": "node scripts/test-email.mjs",
    "email:preview": "npm --workspace=@research-management/email run build && node scripts/preview-notification-emails.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "db:push": "npm --workspace=@research-management/database run db:push",
    "db:seed": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run seed",
    "db:seed:demo": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run seed:demo",
    "db:bootstrap-admin": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run bootstrap:admin",
    "db:panel-demo": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run panel-demo --",
    "test:panel-demo": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run test:panel-demo",
    "db:demo-themes": "npm --workspace=@research-management/database run demo:themes:seed",
    "db:demo-themes:cleanup": "npm --workspace=@research-management/database run demo:themes:cleanup",
    "demo:local:init": "node --env-file=.env.demo.local scripts/local-demo.mjs init",
    "demo:local:verify": "node --env-file=.env.demo.local scripts/local-demo.mjs verify",
    "demo:local:reset": "node --env-file=.env.demo.local scripts/local-demo.mjs reset",
    "demo:local:cleanup": "node --env-file=.env.demo.local scripts/local-demo.mjs cleanup",
    "demo:local:verify-api": "node --env-file=.env.demo.local scripts/verify-local-demo-api.mjs",
    "dev:demo": "node --env-file=.env.demo.local scripts/local-demo.mjs dev",
    "test:demo-local": "tsc -p packages/database/tsconfig.json && npm --workspace=@research-management/database run test:demo-local",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:integration": "npm --workspace=api run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "walkthrough:researcher:capture": "node scripts/walkthrough/capture-researcher.mjs",
    "walkthrough:researcher:voice": "node scripts/walkthrough/voice.mjs",
    "walkthrough:researcher:render": "node scripts/walkthrough/render.mjs --publish",
    "walkthrough:researcher:guides": "node scripts/walkthrough/guides.mjs",
    "walkthrough:researcher:all": "node scripts/walkthrough/all.mjs",
    "test:walkthrough": "node --test scripts/walkthrough/timing.test.mjs scripts/walkthrough/coordinator-script.test.mjs scripts/walkthrough/adviser-script.test.mjs scripts/walkthrough/panelist-script.test.mjs",
    "type-check:walkthrough": "tsc -p walkthrough/tsconfig.json",
    "walkthrough:researcher:verify": "node scripts/walkthrough/verify-export.mjs --browser",
    "walkthrough:researcher:preview": "node scripts/walkthrough/preview.mjs",
    "walkthrough:dean:dev": "node --import tsx scripts/walkthrough/dean-server.mjs",
    "walkthrough:dean:voice": "node scripts/walkthrough/voice.mjs --role=dean",
    "walkthrough:dean:capture": "node scripts/walkthrough/capture-dean.mjs --role=dean",
    "walkthrough:dean:render": "node scripts/walkthrough/render.mjs --role=dean --native",
    "walkthrough:dean:verify": "node scripts/walkthrough/verify-export.mjs --role=dean",
    "walkthrough:dean:preview": "node scripts/walkthrough/preview-dean.mjs",
    "walkthrough:coordinator:dev": "node --import tsx scripts/walkthrough/coordinator-server.mjs",
    "walkthrough:coordinator:prepare": "node --import tsx scripts/walkthrough/prepare-coordinator.mjs",
    "walkthrough:coordinator:voice": "node scripts/walkthrough/voice.mjs --role=coordinator",
    "walkthrough:coordinator:capture": "node scripts/walkthrough/capture-coordinator.mjs --role=coordinator",
    "walkthrough:coordinator:render": "node scripts/walkthrough/render.mjs --role=coordinator --native --chapters",
    "walkthrough:coordinator:verify": "node scripts/walkthrough/verify-export.mjs --role=coordinator",
    "walkthrough:coordinator:preview": "node scripts/walkthrough/preview-coordinator.mjs",
    "walkthrough:adviser:dev": "node --import tsx scripts/walkthrough/adviser-server.mjs",
    "walkthrough:adviser:capture": "node scripts/walkthrough/capture-adviser.mjs --role=adviser",
    "walkthrough:adviser:voice": "node scripts/walkthrough/voice.mjs --role=adviser",
    "walkthrough:adviser:render": "node scripts/walkthrough/render.mjs --role=adviser --native --chapters",
    "walkthrough:adviser:verify": "node scripts/walkthrough/verify-export.mjs --role=adviser",
    "walkthrough:adviser:preview": "node scripts/walkthrough/preview-adviser.mjs",
    "walkthrough:publish": "node scripts/walkthrough/publish-role-videos.mjs",
    "walkthrough:panelist:dev": "node --import tsx scripts/walkthrough/panelist-server.mjs",
    "walkthrough:panelist:prepare": "node --import tsx scripts/walkthrough/prepare-panelist.mjs",
    "walkthrough:panelist:capture": "node scripts/walkthrough/capture-panelist.mjs --role=panelist",
    "walkthrough:panelist:voice": "node scripts/walkthrough/voice.mjs --role=panelist",
    "walkthrough:panelist:variants": "node scripts/walkthrough/panelist-variants.mjs",
    "walkthrough:panelist:preview": "node scripts/walkthrough/preview-panelist.mjs"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.64.1",
    "prettier": "^3.3.3",
    "remotion": "4.0.540",
    "tsx": "4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.3",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "postcss": "8.5.30"
  }
}
