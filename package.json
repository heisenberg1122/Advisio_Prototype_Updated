{
  "name": "research-management-system",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:push": "npm --workspace=@research-management/database run db:push",
    "db:seed": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run seed",
    "db:seed:demo": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run seed:demo",
    "db:bootstrap-admin": "npm --workspace=@research-management/database run build && npm --workspace=@research-management/database run bootstrap:admin",
    "db:demo-themes": "npm --workspace=@research-management/database run demo:themes:seed",
    "db:demo-themes:cleanup": "npm --workspace=@research-management/database run demo:themes:cleanup",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:integration": "npm --workspace=api run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.3",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "postcss": "8.5.30"
  }
}
