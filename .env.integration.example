# Copy to .env.integration.local and use credentials for an isolated local test database.
# This file does not configure the application or the development database.
NODE_ENV=test
RUN_DATABASE_INTEGRATION_TESTS=1
INTEGRATION_DATABASE_EXPECTED_NAME=advisio_test
INTEGRATION_DATABASE_URL="postgresql://advisio_test:replace-with-local-test-password@127.0.0.1:5434/advisio_test?schema=public&application_name=advisio-integration-tests"
JWT_SECRET=replace-with-a-local-test-only-secret
